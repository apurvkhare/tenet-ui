{
  "id": "select",
  "name": "Select",
  "status": "stable",
  "a11yReviewed": true,
  "importPath": "tenet-ui",
  "source": "src/components/Select/Select.tsx",
  "props": [
    {
      "name": "options",
      "type": "{ value: string; label: string; disabled?: boolean }[]",
      "required": true,
      "defaultValue": "",
      "description": "The options to choose from."
    },
    {
      "name": "value",
      "type": "string",
      "required": false,
      "defaultValue": "",
      "description": "Controlled selected value."
    },
    {
      "name": "defaultValue",
      "type": "string",
      "required": false,
      "defaultValue": "",
      "description": "Uncontrolled initial value."
    },
    {
      "name": "onChange",
      "type": "(value: string) => void",
      "required": false,
      "defaultValue": "",
      "description": "Called with the newly selected value."
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "defaultValue": "Select…",
      "description": "Text shown when nothing is selected."
    },
    {
      "name": "size",
      "type": "'small' | 'medium' | 'large'",
      "required": false,
      "defaultValue": "medium",
      "description": "Control height / font scale."
    },
    {
      "name": "block",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Stretch to fill the available width."
    },
    {
      "name": "invalid",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Invalid state (danger border + aria-invalid)."
    },
    {
      "name": "name",
      "type": "string",
      "required": false,
      "defaultValue": "",
      "description": "Form field name — emits a hidden input so the value submits with a form."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Disable the control."
    },
    {
      "name": "required",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "Sets aria-required (FormControl wires this)."
    },
    {
      "name": "id",
      "type": "string",
      "required": false,
      "defaultValue": "",
      "description": "Id for the trigger (FormControl sets this automatically)."
    },
    {
      "name": "aria-label",
      "type": "string",
      "required": false,
      "defaultValue": "",
      "description": "Accessible name when not inside a FormControl."
    },
    {
      "name": "aria-describedby",
      "type": "string",
      "required": false,
      "defaultValue": "",
      "description": "Ids of describing elements (FormControl wires this)."
    }
  ],
  "stories": [
    { "id": "components-select--default" },
    { "id": "components-select--with-placeholder" },
    { "id": "components-select--with-disabled-option" }
  ],
  "subcomponents": []
}
