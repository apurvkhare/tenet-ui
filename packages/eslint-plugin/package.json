{
  "name": "eslint-plugin-tenet-ui",
  "version": "0.4.0",
  "description": "ESLint rules for the tenet-ui design system: tokens over raw values, components over raw elements, the styles.css runtime contract, and the deprecation registry.",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "lib",
    "rules",
    "data",
    "README.md"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "design-system",
    "design-tokens",
    "tenet-ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apurvkhare/tenet-ui.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://tenet-ui.pages.dev/",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "demo": "node scripts/demo.mjs",
    "demo:json": "node scripts/demo.mjs --json"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
