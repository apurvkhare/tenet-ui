{
  "name": "tenet-ui",
  "version": "0.4.0",
  "description": "Tenet Design System — design tokens, React components, and icons for the Editorial Ink identity.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apurvkhare/tenet-ui.git"
  },
  "homepage": "https://apurvkhare.github.io/tenet-ui/",
  "bugs": {
    "url": "https://github.com/apurvkhare/tenet-ui/issues"
  },
  "author": "Tenet",
  "keywords": [
    "design-system",
    "react",
    "components",
    "design-tokens",
    "ui"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./icons": {
      "import": {
        "types": "./dist/icons.d.ts",
        "default": "./dist/icons.js"
      },
      "require": {
        "types": "./dist/icons.d.cts",
        "default": "./dist/icons.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./generated/components.json": "./generated/components.json",
    "./generated/deprecations.json": "./generated/deprecations.json",
    "./generated/icons.json": "./generated/icons.json",
    "./generated/guidelines/*": "./generated/guidelines/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "generated",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:icons": "node scripts/build-icons.mjs",
    "build:js": "tsup",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:styles": "node scripts/build-styles.mjs",
    "build": "npm run build:icons && npm run build:js && npm run build:tokens && npm run build:catalog && npm run build:styles",
    "typecheck": "tsc --noEmit -p tsconfig.verify.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:story-ids": "node scripts/check-story-ids.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "build:baselines": "node scripts/build-baselines.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "axe-core": "^4.13.0",
    "lucide-static": "^1.45.0",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  }
}
