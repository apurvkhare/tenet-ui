{
  "name": "tenet-ui",
  "version": "0.1.0",
  "description": "Tenet Design System — a small, realistic in-house design system (tokens + React components) used to demo the design-system skill.",
  "type": "module",
  "license": "MIT",
  "author": "Tenet",
  "keywords": [
    "design-system",
    "react",
    "components",
    "design-tokens",
    "ui"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./generated/components.json": "./generated/components.json"
  },
  "files": [
    "dist",
    "generated"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:js": "tsup",
    "build:styles": "node scripts/build-styles.mjs",
    "build": "npm run build:js && npm run build:tokens && npm run build:catalog && npm run build:styles",
    "typecheck": "tsc --noEmit -p tsconfig.verify.json",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
