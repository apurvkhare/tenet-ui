{
  "base": {
    "color": {
      "white": { "$value": "#ffffff", "$type": "color" },
      "black": { "$value": "#1b1f24", "$type": "color" },
      "neutral": {
        "100": { "$value": "#f6f8fa", "$type": "color" },
        "200": { "$value": "#eaeef2", "$type": "color" },
        "300": { "$value": "#d0d7de", "$type": "color" },
        "400": { "$value": "#afb8c1", "$type": "color" },
        "500": { "$value": "#8c959f", "$type": "color" },
        "600": { "$value": "#6e7781", "$type": "color" },
        "700": { "$value": "#424a53", "$type": "color" },
        "800": { "$value": "#32383f", "$type": "color" },
        "900": { "$value": "#24292f", "$type": "color" }
      },
      "blue": {
        "400": { "$value": "#54aeff", "$type": "color" },
        "500": { "$value": "#0969da", "$type": "color" },
        "600": { "$value": "#0550ae", "$type": "color" }
      },
      "green": {
        "500": { "$value": "#1a7f37", "$type": "color" },
        "600": { "$value": "#116329", "$type": "color" }
      },
      "red": {
        "500": { "$value": "#cf222e", "$type": "color" },
        "600": { "$value": "#a40e26", "$type": "color" }
      }
    },
    "size": {
      "4": { "$value": "4px", "$type": "dimension" },
      "8": { "$value": "8px", "$type": "dimension" },
      "12": { "$value": "12px", "$type": "dimension" },
      "16": { "$value": "16px", "$type": "dimension" },
      "24": { "$value": "24px", "$type": "dimension" },
      "28": { "$value": "28px", "$type": "dimension" },
      "32": { "$value": "32px", "$type": "dimension" },
      "40": { "$value": "40px", "$type": "dimension" }
    }
  },
  "fgColor": {
    "default": { "$value": "{base.color.neutral.900}", "$type": "color", "$description": "Primary text color." },
    "muted": { "$value": "{base.color.neutral.600}", "$type": "color", "$description": "Secondary / less prominent text." },
    "onEmphasis": { "$value": "{base.color.white}", "$type": "color", "$description": "Text on a solid emphasis background." },
    "accent": { "$value": "{base.color.blue.500}", "$type": "color", "$description": "Accent / link text color." },
    "danger": { "$value": "{base.color.red.500}", "$type": "color", "$description": "Danger / destructive text color." }
  },
  "bgColor": {
    "default": { "$value": "{base.color.white}", "$type": "color", "$description": "Default surface background." },
    "muted": { "$value": "{base.color.neutral.100}", "$type": "color", "$description": "Muted surface background." },
    "emphasis": { "$value": "{base.color.neutral.900}", "$type": "color", "$description": "High-contrast background." },
    "accent": {
      "emphasis": { "$value": "{base.color.blue.500}", "$type": "color", "$description": "Solid accent background (primary action)." },
      "muted": { "$value": "{base.color.blue.400}", "$type": "color", "$description": "Subtle accent background." }
    },
    "danger": {
      "emphasis": { "$value": "{base.color.red.500}", "$type": "color", "$description": "Solid danger background." }
    },
    "success": {
      "emphasis": { "$value": "{base.color.green.500}", "$type": "color", "$description": "Solid success background." }
    }
  },
  "borderColor": {
    "default": { "$value": "{base.color.neutral.300}", "$type": "color", "$description": "Default border color." },
    "muted": { "$value": "{base.color.neutral.200}", "$type": "color", "$description": "Muted / subtle border." },
    "accent": {
      "emphasis": { "$value": "{base.color.blue.500}", "$type": "color", "$description": "Accent border color." }
    }
  },
  "space": {
    "1": { "$value": "{base.size.4}", "$type": "dimension", "$description": "4px" },
    "2": { "$value": "{base.size.8}", "$type": "dimension", "$description": "8px" },
    "3": { "$value": "{base.size.12}", "$type": "dimension", "$description": "12px" },
    "4": { "$value": "{base.size.16}", "$type": "dimension", "$description": "16px" },
    "5": { "$value": "{base.size.24}", "$type": "dimension", "$description": "24px" },
    "6": { "$value": "{base.size.32}", "$type": "dimension", "$description": "32px" }
  },
  "borderRadius": {
    "small": { "$value": "4px", "$type": "dimension" },
    "medium": { "$value": "6px", "$type": "dimension" },
    "large": { "$value": "12px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "fontSize": {
    "0": { "$value": "12px", "$type": "dimension" },
    "1": { "$value": "14px", "$type": "dimension" },
    "2": { "$value": "16px", "$type": "dimension" },
    "3": { "$value": "20px", "$type": "dimension" },
    "4": { "$value": "24px", "$type": "dimension" }
  },
  "fontWeight": {
    "normal": { "$value": "400", "$type": "fontWeight" },
    "medium": { "$value": "500", "$type": "fontWeight" },
    "semibold": { "$value": "600", "$type": "fontWeight" },
    "bold": { "$value": "700", "$type": "fontWeight" }
  },
  "control": {
    "small": { "size": { "$value": "{base.size.28}", "$type": "dimension", "$description": "Small control height." } },
    "medium": { "size": { "$value": "{base.size.32}", "$type": "dimension", "$description": "Medium control height." } },
    "large": { "size": { "$value": "{base.size.40}", "$type": "dimension", "$description": "Large control height." } }
  },
  "shadow": {
    "resting": { "$value": "0 1px 0 rgba(27, 31, 36, 0.04)", "$type": "shadow", "$description": "Resting elevation." },
    "medium": { "$value": "0 3px 6px rgba(140, 149, 159, 0.15)", "$type": "shadow", "$description": "Raised elevation (cards, menus)." }
  }
}
