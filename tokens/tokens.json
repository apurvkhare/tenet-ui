{
  "base": {
    "color": {
      "white": { "$value": "#ffffff", "$type": "color" },
      "black": { "$value": "#14110d", "$type": "color" },
      "neutral": {
        "50": { "$value": "#fbf7f0", "$type": "color", "$description": "Warm paper." },
        "100": { "$value": "#f4eee3", "$type": "color" },
        "200": { "$value": "#ebe3d5", "$type": "color" },
        "300": { "$value": "#ddd2bf", "$type": "color" },
        "400": { "$value": "#c7b9a1", "$type": "color" },
        "500": { "$value": "#a1927a", "$type": "color" },
        "600": { "$value": "#807156", "$type": "color" },
        "650": { "$value": "#6e6049", "$type": "color", "$description": "Muted text — AA on paper/white/muted." },
        "700": { "$value": "#574b39", "$type": "color" },
        "800": { "$value": "#3d3528", "$type": "color" },
        "900": { "$value": "#2a241b", "$type": "color", "$description": "Primary ink." },
        "950": { "$value": "#211d17", "$type": "color" },
        "1000": { "$value": "#14110d", "$type": "color" }
      },
      "clay": {
        "300": { "$value": "#e9a487", "$type": "color" },
        "400": { "$value": "#d9744e", "$type": "color" },
        "500": { "$value": "#c2502e", "$type": "color", "$description": "Primary accent (terracotta)." },
        "600": { "$value": "#a23e1f", "$type": "color", "$description": "Accent text — AA on light." }
      },
      "olive": {
        "300": { "$value": "#9cb87a", "$type": "color" },
        "400": { "$value": "#6e8c4f", "$type": "color" },
        "500": { "$value": "#4f6f3a", "$type": "color", "$description": "Success solid." },
        "600": { "$value": "#3c5630", "$type": "color", "$description": "Success text — AA on light." }
      },
      "brick": {
        "300": { "$value": "#e7a99b", "$type": "color" },
        "400": { "$value": "#d07a66", "$type": "color" },
        "500": { "$value": "#a8341f", "$type": "color", "$description": "Danger solid." },
        "600": { "$value": "#8a2817", "$type": "color", "$description": "Danger text — AA on light." }
      },
      "ochre": {
        "300": { "$value": "#dcc06a", "$type": "color" },
        "400": { "$value": "#c49a3d", "$type": "color" },
        "500": { "$value": "#b5851f", "$type": "color", "$description": "Attention solid." },
        "600": { "$value": "#80600f", "$type": "color", "$description": "Attention text — AA on light + on tint." }
      }
    },
    "size": {
      "4": { "$value": "4px", "$type": "dimension" },
      "8": { "$value": "8px", "$type": "dimension" },
      "12": { "$value": "12px", "$type": "dimension" },
      "16": { "$value": "16px", "$type": "dimension" },
      "24": { "$value": "24px", "$type": "dimension" },
      "28": { "$value": "28px", "$type": "dimension" },
      "32": { "$value": "32px", "$type": "dimension" },
      "40": { "$value": "40px", "$type": "dimension" }
    }
  },

  "fontFamily": {
    "display": {
      "$value": "'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, 'Times New Roman', serif",
      "$type": "fontFamily",
      "$description": "Serif display face for headings — the editorial signature."
    },
    "body": {
      "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
      "$type": "fontFamily",
      "$description": "Humanist sans for body and controls."
    },
    "mono": {
      "$value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace",
      "$type": "fontFamily",
      "$description": "Monospace for counts / code."
    }
  },

  "space": {
    "1": { "$value": "{base.size.4}", "$type": "dimension", "$description": "4px" },
    "2": { "$value": "{base.size.8}", "$type": "dimension", "$description": "8px" },
    "3": { "$value": "{base.size.12}", "$type": "dimension", "$description": "12px" },
    "4": { "$value": "{base.size.16}", "$type": "dimension", "$description": "16px" },
    "5": { "$value": "{base.size.24}", "$type": "dimension", "$description": "24px" },
    "6": { "$value": "{base.size.32}", "$type": "dimension", "$description": "32px" }
  },
  "borderWidth": {
    "thin": { "$value": "1px", "$type": "dimension", "$description": "Default hairline border." },
    "thick": { "$value": "2px", "$type": "dimension", "$description": "Emphasized border." }
  },
  "borderRadius": {
    "small": { "$value": "3px", "$type": "dimension", "$description": "Crisp — tags, options." },
    "medium": { "$value": "5px", "$type": "dimension", "$description": "Controls, cards." },
    "large": { "$value": "9px", "$type": "dimension", "$description": "Surfaces, popovers." },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "fontSize": {
    "0": { "$value": "12px", "$type": "dimension" },
    "1": { "$value": "14px", "$type": "dimension" },
    "2": { "$value": "16px", "$type": "dimension" },
    "3": { "$value": "20px", "$type": "dimension" },
    "4": { "$value": "28px", "$type": "dimension" },
    "5": { "$value": "36px", "$type": "dimension", "$description": "Display size — page titles (Heading level 1)." }
  },
  "lineHeight": {
    "tight": { "$value": "1.2", "$type": "number", "$description": "Headings and single-line controls." },
    "default": { "$value": "1.5", "$type": "number", "$description": "Body copy." }
  },
  "breakpoint": {
    "sm": { "$value": "640px", "$type": "dimension", "$description": "Small: phones landscape / narrow tablets. CSS @media cannot read var(); Grid hardcodes the same value with a comment." },
    "md": { "$value": "960px", "$type": "dimension", "$description": "Medium: tablets / narrow laptops." },
    "lg": { "$value": "1280px", "$type": "dimension", "$description": "Large: desktop." }
  },
  "fontWeight": {
    "normal": { "$value": "400", "$type": "fontWeight" },
    "medium": { "$value": "500", "$type": "fontWeight" },
    "semibold": { "$value": "600", "$type": "fontWeight" },
    "bold": { "$value": "700", "$type": "fontWeight" }
  },
  "letterSpacing": {
    "tag": { "$value": "0.04em", "$type": "dimension", "$description": "Slight tracking for the uppercase tag look." }
  },
  "control": {
    "small": { "size": { "$value": "{base.size.28}", "$type": "dimension", "$description": "Small control height." } },
    "medium": { "size": { "$value": "{base.size.32}", "$type": "dimension", "$description": "Medium control height." } },
    "large": { "size": { "$value": "{base.size.40}", "$type": "dimension", "$description": "Large control height." } }
  },
  "shadow": {
    "resting": { "$value": "0 1px 2px rgba(31, 27, 22, 0.06)", "$type": "shadow", "$description": "Resting elevation (warm)." },
    "medium": { "$value": "0 6px 16px rgba(31, 27, 22, 0.12)", "$type": "shadow", "$description": "Raised elevation (cards, menus, popovers)." },
    "focus": { "$value": "0 0 0 3px var(--bgColor-accent-muted)", "$type": "shadow", "$description": "Focus ring halo for fields." }
  },

  "themes": {
    "light": {
      "fgColor": {
        "default": { "$value": "{base.color.neutral.900}", "$type": "color", "$description": "Primary text color.", "$extensions": { "tenet": { "contrast": { "aa": ["bgColor-default","bgColor-muted","bgColor-inset","bgColor-accent-muted","bgColor-success-muted","bgColor-danger-muted","bgColor-attention-emphasis","bgColor-attention-muted"], "aaLarge": ["bgColor-accent-emphasis"] } } } },
        "muted": { "$value": "{base.color.neutral.650}", "$type": "color", "$description": "Secondary text (AA on paper / muted).", "$extensions": { "tenet": { "contrast": { "aa": ["bgColor-default","bgColor-muted","bgColor-inset","bgColor-accent-muted","bgColor-success-muted","bgColor-danger-muted","bgColor-attention-muted"], "aaLarge": [] } } } },
        "onEmphasis": { "$value": "{base.color.white}", "$type": "color", "$description": "Text on a solid emphasis background.", "$extensions": { "tenet": { "contrast": { "aa": ["bgColor-emphasis","bgColor-accent-emphasis","bgColor-success-emphasis","bgColor-danger-emphasis"], "aaLarge": ["bgColor-attention-emphasis"] } } } },
        "accent": { "$value": "{base.color.clay.600}", "$type": "color", "$description": "Accent / link text color.", "$extensions": { "tenet": { "contrast": { "aa": ["bgColor-default","bgColor-muted","bgColor-inset","bgColor-accent-muted","bgColor-success-muted","bgColor-danger-muted","bgColor-attention-muted"], "aaLarge": [] } } } },
        "danger": { "$value": "{base.color.brick.600}", "$type": "color", "$description": "Danger text color.", "$extensions": { "tenet": { "contrast": { "aa": ["bgColor-default","bgColor-muted","bgColor-inset","bgColor-accent-muted","bgColor-success-muted","bgColor-danger-muted","bgColor-attention-muted"], "aaLarge": [] } } } },
        "success": { "$value": "{base.color.olive.600}", "$type": "color", "$description": "Success text color.", "$extensions": { "tenet": { "contrast": { "aa": ["bgColor-default","bgColor-muted","bgColor-inset","bgColor-accent-muted","bgColor-success-muted","bgColor-danger-muted","bgColor-attention-muted"], "aaLarge": [] } } } },
        "attention": { "$value": "{base.color.ochre.600}", "$type": "color", "$description": "Attention / warning text color.", "$extensions": { "tenet": { "contrast": { "aa": ["bgColor-default","bgColor-muted","bgColor-inset","bgColor-accent-muted","bgColor-success-muted","bgColor-danger-muted","bgColor-attention-muted"], "aaLarge": [] } } } },
        "onAttention": { "$value": "{base.color.neutral.900}", "$type": "color", "$description": "Dark text on a solid attention (ochre) background — same ink in both themes.", "$extensions": { "tenet": { "contrast": { "aa": ["bgColor-default","bgColor-muted","bgColor-inset","bgColor-accent-muted","bgColor-success-muted","bgColor-danger-muted","bgColor-attention-emphasis","bgColor-attention-muted"], "aaLarge": ["bgColor-accent-emphasis"] } } } }
      },
      "bgColor": {
        "default": { "$value": "{base.color.white}", "$type": "color", "$description": "Default surface background." },
        "muted": { "$value": "{base.color.neutral.100}", "$type": "color", "$description": "Muted surface background." },
        "inset": { "$value": "{base.color.neutral.50}", "$type": "color", "$description": "Page / inset background (warm paper)." },
        "backdrop": { "$value": "rgba(20, 17, 13, 0.5)", "$type": "color", "$description": "Modal scrim behind dialogs." },
        "emphasis": { "$value": "{base.color.neutral.900}", "$type": "color", "$description": "High-contrast background (ink)." },
        "accent": {
          "emphasis": { "$value": "{base.color.clay.500}", "$type": "color", "$description": "Solid accent background (primary action)." },
          "muted": { "$value": "#f5e4db", "$type": "color", "$description": "Soft accent tint (tags, focus halo)." }
        },
        "success": {
          "emphasis": { "$value": "{base.color.olive.500}", "$type": "color", "$description": "Solid success background." },
          "muted": { "$value": "#e7eedd", "$type": "color", "$description": "Soft success tint." }
        },
        "danger": {
          "emphasis": { "$value": "{base.color.brick.500}", "$type": "color", "$description": "Solid danger background." },
          "muted": { "$value": "#f8e3dc", "$type": "color", "$description": "Soft danger tint." }
        },
        "attention": {
          "emphasis": { "$value": "{base.color.ochre.500}", "$type": "color", "$description": "Solid attention background." },
          "muted": { "$value": "#f6ecd2", "$type": "color", "$description": "Soft attention tint." }
        }
      },
      "borderColor": {
        "default": { "$value": "{base.color.neutral.300}", "$type": "color", "$description": "Default border color." },
        "muted": { "$value": "{base.color.neutral.200}", "$type": "color", "$description": "Muted / subtle border." },
        "accent": {
          "emphasis": { "$value": "{base.color.clay.500}", "$type": "color", "$description": "Accent border color." },
          "muted": { "$value": "#ecc9b8", "$type": "color", "$description": "Soft accent tag border." }
        },
        "success": { "muted": { "$value": "#cfe0bc", "$type": "color", "$description": "Soft success tag border." } },
        "danger": { "muted": { "$value": "#efc9be", "$type": "color", "$description": "Soft danger tag border." } },
        "attention": { "muted": { "$value": "#ead9a8", "$type": "color", "$description": "Soft attention tag border." } }
      }
    },

    "dark": {
      "fgColor": {
        "default": { "$value": "{base.color.neutral.100}", "$type": "color", "$description": "Primary text color.", "$extensions": { "tenet": { "contrast": { "aa": ["bgColor-default","bgColor-muted","bgColor-inset","bgColor-accent-muted","bgColor-success-emphasis","bgColor-success-muted","bgColor-danger-emphasis","bgColor-danger-muted","bgColor-attention-muted"], "aaLarge": ["bgColor-accent-emphasis"] } } } },
        "muted": { "$value": "{base.color.neutral.500}", "$type": "color", "$description": "Secondary text (AA on warm dark).", "$extensions": { "tenet": { "contrast": { "aa": ["bgColor-default","bgColor-muted","bgColor-inset","bgColor-accent-muted","bgColor-success-muted","bgColor-danger-muted","bgColor-attention-muted"], "aaLarge": [] } } } },
        "onEmphasis": { "$value": "{base.color.white}", "$type": "color", "$description": "Text on a solid colored emphasis background (clay/brick/olive) — white in both themes.", "$extensions": { "tenet": { "contrast": { "aa": ["bgColor-default","bgColor-muted","bgColor-inset","bgColor-accent-emphasis","bgColor-accent-muted","bgColor-success-emphasis","bgColor-success-muted","bgColor-danger-emphasis","bgColor-danger-muted","bgColor-attention-muted"], "aaLarge": ["bgColor-attention-emphasis"] } } } },
        "accent": { "$value": "{base.color.clay.300}", "$type": "color", "$description": "Accent / link text color.", "$extensions": { "tenet": { "contrast": { "aa": ["bgColor-default","bgColor-muted","bgColor-inset","bgColor-accent-muted","bgColor-success-muted","bgColor-danger-muted","bgColor-attention-muted"], "aaLarge": ["bgColor-danger-emphasis"] } } } },
        "danger": { "$value": "{base.color.brick.300}", "$type": "color", "$description": "Danger text color.", "$extensions": { "tenet": { "contrast": { "aa": ["bgColor-default","bgColor-muted","bgColor-inset","bgColor-accent-muted","bgColor-success-muted","bgColor-danger-muted","bgColor-attention-muted"], "aaLarge": ["bgColor-danger-emphasis"] } } } },
        "success": { "$value": "{base.color.olive.300}", "$type": "color", "$description": "Success text color.", "$extensions": { "tenet": { "contrast": { "aa": ["bgColor-default","bgColor-muted","bgColor-inset","bgColor-accent-muted","bgColor-success-muted","bgColor-danger-muted","bgColor-attention-muted"], "aaLarge": ["bgColor-danger-emphasis"] } } } },
        "attention": { "$value": "{base.color.ochre.300}", "$type": "color", "$description": "Attention / warning text color.", "$extensions": { "tenet": { "contrast": { "aa": ["bgColor-default","bgColor-muted","bgColor-inset","bgColor-accent-muted","bgColor-success-muted","bgColor-danger-muted","bgColor-attention-muted"], "aaLarge": ["bgColor-success-emphasis","bgColor-danger-emphasis"] } } } },
        "onAttention": { "$value": "{base.color.neutral.900}", "$type": "color", "$description": "Dark text on a solid attention (ochre) background — same ink in both themes.", "$extensions": { "tenet": { "contrast": { "aa": ["bgColor-emphasis","bgColor-attention-emphasis"], "aaLarge": ["bgColor-accent-emphasis"] } } } }
      },
      "bgColor": {
        "default": { "$value": "#1a1712", "$type": "color", "$description": "Default surface (warm espresso)." },
        "muted": { "$value": "#211d17", "$type": "color", "$description": "Muted surface background." },
        "inset": { "$value": "#14110d", "$type": "color", "$description": "Page / inset background." },
        "backdrop": { "$value": "rgba(0, 0, 0, 0.6)", "$type": "color", "$description": "Modal scrim behind dialogs." },
        "emphasis": { "$value": "{base.color.neutral.100}", "$type": "color", "$description": "High-contrast (light) background." },
        "accent": {
          "emphasis": { "$value": "{base.color.clay.500}", "$type": "color", "$description": "Solid accent background (primary action)." },
          "muted": { "$value": "#3a2117", "$type": "color", "$description": "Soft accent tint." }
        },
        "success": {
          "emphasis": { "$value": "{base.color.olive.500}", "$type": "color", "$description": "Solid success background." },
          "muted": { "$value": "#24301a", "$type": "color", "$description": "Soft success tint." }
        },
        "danger": {
          "emphasis": { "$value": "{base.color.brick.500}", "$type": "color", "$description": "Solid danger background." },
          "muted": { "$value": "#3a1e18", "$type": "color", "$description": "Soft danger tint." }
        },
        "attention": {
          "emphasis": { "$value": "{base.color.ochre.500}", "$type": "color", "$description": "Solid attention background." },
          "muted": { "$value": "#332813", "$type": "color", "$description": "Soft attention tint." }
        }
      },
      "borderColor": {
        "default": { "$value": "{base.color.neutral.800}", "$type": "color", "$description": "Default border color." },
        "muted": { "$value": "{base.color.neutral.900}", "$type": "color", "$description": "Muted / subtle border." },
        "accent": {
          "emphasis": { "$value": "{base.color.clay.400}", "$type": "color", "$description": "Accent border color." },
          "muted": { "$value": "#5a3320", "$type": "color", "$description": "Soft accent tag border." }
        },
        "success": { "muted": { "$value": "#33492a", "$type": "color", "$description": "Soft success tag border." } },
        "danger": { "muted": { "$value": "#5a2c22", "$type": "color", "$description": "Soft danger tag border." } },
        "attention": { "muted": { "$value": "#4d3c1c", "$type": "color", "$description": "Soft attention tag border." } }
      }
    }
  }
}
